{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "linden",
  "name": "Multic Studio Product Guide",
  "description": "Step-by-step guides for every product - platform setup, analytics, and integrations in one place.",
  "colors": {
    "primary": "#FEDD00",
    "light": "#FEDD00",
    "dark": "#FEDD00"
  },
  "favicon": {
    "light": "/images/faviconwhite.png",
    "dark": "/images/faviconblack.png"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "section"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        },
        {
          "anchor": "Changelog",
          "icon": "scroll-text",
          "href": "https://studio.multic.com/release-notes"
        },
        {
          "anchor": "Help",
          "icon": "life-buoy",
          "href": "https://www.mintlify.com/docs/contact-support"
        }
      ]
    },
    "directory": "card",
    "groups": [
      {
        "group": "Platform",
        "icon": "layers",
        "expanded": true,
        "pages": [
          "platform/quickstart",
          "platform/key-concepts",
          "platform/configuration/settings",
          "platform/configuration/user-management",
          "platform/administration/roles-permissions"
        ]
      },
      {
        "group": "Analytics",
        "icon": "chart-bar",
        "expanded": true,
        "pages": [
          "analytics/quickstart",
          "analytics/connect-data",
          "analytics/dashboards/create-dashboard",
          "analytics/reports/scheduled-reports"
        ]
      },
      {
        "group": "Integrations",
        "icon": "plug",
        "expanded": true,
        "pages": [
          "integrations/quickstart",
          "integrations/authentication",
          "integrations/connectors/crm",
          "integrations/webhooks/configure"
        ]
      },
      {
        "group": "Untitled Group",
        "pages": []
      }
    ]
  },
  "logo": {
    "light": "/images/light.svg",
    "dark": "/images/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/yourcompany",
      "linkedin": "https://linkedin.com/company/yourcompany"
    }
  },
  "background": {
    "color": {
      "dark": "#0A0A0A"
    }
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 800
    },
    "body": {
      "family": "Inter",
      "weight": 300
    }
  }
}

{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "linden",
  "name": "Multic docs",
  "description": "Working public documentation for making and playing interactive comics with Multic.",
  "colors": {
    "primary": "#806A00",
    "light": "#FEDD00",
    "dark": "#806A00"
  },
  "favicon": "/favicon.ico",
  "logo": {
    "light": "/images/light.svg",
    "dark": "/images/dark.svg"
  },
  "icons": {
    "library": "lucide"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "styling": {
    "eyebrows": "section"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        }
      ]
    },
    "groups": [
      {
        "group": "Start here",
        "icon": "route",
        "expanded": true,
        "pages": [
          "getting-started/what-is-a-multic"
        ]
      },
      {
        "group": "Core concepts",
        "icon": "shapes",
        "expanded": true,
        "pages": [
          "concepts/group-play"
        ]
      }
    ]
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Open Studio",
      "href": "https://studio.multic.com"
    }
  },
  "contextual": {
    "options": ["copy", "view"]
  },
  "search": {
    "prompt": "Search Multic docs..."
  },
  "metadata": {
    "timestamp": true
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "robots": "noindex, nofollow",
      "googlebot": "noindex, nofollow"
    }
  },
  "banner": {
    "content": "Working preview — product and tone review are still in progress.",
    "dismissible": false,
    "type": "warning"
  },
  "background": {
    "color": {
      "light": "#FFFEF5",
      "dark": "#0A0A0A"
    }
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 800
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  }
}
